generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  SHOPKEEPER
  BUYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ProductType {
  EQUIPMENT
  JERSEY
  TSHIRT
  APPAREL
  ACCESSORY
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StoreType {
  RETAIL
  WAREHOUSE
  ONLINE
  PICKUP
}

enum WarehouseType {
  CENTRAL
  STORE_BACKROOM
  FULFILLMENT
  TRANSIT
}

enum InventoryMovementType {
  RECEIPT
  SALE
  POS_SALE
  RESERVATION
  RESERVATION_RELEASE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  LOSS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRINTING
  PACKED
  DISPATCHED
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  RAZORPAY
  STRIPE
  OTHER
}

enum CustomizationStatus {
  DRAFT
  SAVED
  IN_CART
  ORDERED
  IN_PRODUCTION
  COMPLETED
  ARCHIVED
}

enum CustomizationSurface {
  FRONT
  BACK
  LEFT_SLEEVE
  RIGHT_SLEEVE
}

enum CustomizationElementType {
  TEXT
  IMAGE
  LOGO
  NUMBER
  NAME
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum POSTransactionStatus {
  OPEN
  COMPLETED
  VOIDED
  REFUNDED
  PENDING_SYNC
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  name            String     @db.VarChar(160)
  phone           String?    @db.VarChar(32)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments UserRole[]
  grantedRoles    UserRole[]       @relation("RoleGrantedBy")
  auditLogs       AuditLog[]
  addresses       Address[]
  orders          Order[]          @relation("BuyerOrders")
  stockMovements  StockMovement[]
  customizations  Customization[]
  carts           Cart[]
  wishlist        Wishlist?
  posTransactions POSTransaction[] @relation("POSCashier")

  @@index([status, createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments UserRole[]

  @@map("roles")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId, createdAt])
  @@index([grantedById])
  @@map("user_roles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(120)
  entity    String   @db.VarChar(120)
  entityId  String?  @map("entity_id") @db.VarChar(160)
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Sport {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.VarChar(1000)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products   ProductSport[]
  categories Category[]

  @@index([active, name])
  @@map("sports")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.VarChar(1000)
  parentId    String?  @map("parent_id") @db.Uuid
  sportId     String?  @map("sport_id") @db.Uuid
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  sport    Sport?     @relation(fields: [sportId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([parentId, name])
  @@index([sportId, active])
  @@index([parentId, sortOrder])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.VarChar(1000)
  logoUrl     String?  @map("logo_url") @db.VarChar(2048)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([active, name])
  @@map("brands")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(220)
  description String        @db.Text
  type        ProductType
  status      ProductStatus @default(DRAFT)
  categoryId  String        @map("category_id") @db.Uuid
  brandId     String?       @map("brand_id") @db.Uuid
  currency    String        @default("INR") @db.Char(3)
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  compareAt   Decimal?      @map("compare_at") @db.Decimal(12, 2)
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sports         ProductSport[]
  variants       ProductVariant[]
  images         ProductImage[]
  orderItems     OrderItem[]
  customizations Customization[]
  wishlistItems  WishlistItem[]
  posItems       POSTransactionItem[]

  @@index([categoryId, status, type])
  @@index([brandId, status])
  @@index([status, createdAt])
  @@map("products")
}

model ProductSport {
  productId String @map("product_id") @db.Uuid
  sportId   String @map("sport_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sport   Sport   @relation(fields: [sportId], references: [id], onDelete: Restrict)

  @@id([productId, sportId])
  @@index([sportId, productId])
  @@map("product_sports")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique @db.VarChar(100)
  variantKey    String   @map("variant_key") @db.VarChar(240)
  name          String?  @db.VarChar(160)
  options       Json     @default("{}")
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product            Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  storeInventory     StoreInventory[]
  warehouseInventory WarehouseInventory[]
  stockMovements     StockMovement[]
  orderItems         OrderItem[]
  customizations     Customization[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  posItems           POSTransactionItem[]

  @@unique([productId, variantKey])
  @@index([productId, active])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(2048)
  altText   String?  @map("alt_text") @db.VarChar(240)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Store {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(160)
  code      String    @unique @db.VarChar(40)
  type      StoreType @default(RETAIL)
  address   Json?
  timezone  String    @default("Asia/Kolkata") @db.VarChar(80)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventories     StoreInventory[]
  movements       StockMovement[]
  orders          Order[]
  posTransactions POSTransaction[]
  warehouses      Warehouse[]

  @@index([active, type])
  @@map("stores")
}

model Warehouse {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(160)
  code      String        @unique @db.VarChar(40)
  type      WarehouseType @default(CENTRAL)
  storeId   String?       @map("store_id") @db.Uuid
  address   Json?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  store       Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  inventories WarehouseInventory[]
  movements   StockMovement[]

  @@index([storeId, active])
  @@map("warehouses")
}

model StoreInventory {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  stockQuantity     Int      @default(0) @map("stock_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([storeId, variantId])
  @@index([storeId, stockQuantity, lowStockThreshold])
  @@index([variantId, storeId])
  @@map("store_inventory")
}

model WarehouseInventory {
  id                String   @id @default(uuid()) @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  stockQuantity     Int      @default(0) @map("stock_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, variantId])
  @@index([warehouseId, stockQuantity, lowStockThreshold])
  @@index([variantId, warehouseId])
  @@map("warehouse_inventory")
}

model StockMovement {
  id            String                @id @default(uuid()) @db.Uuid
  variantId     String                @map("variant_id") @db.Uuid
  storeId       String?               @map("store_id") @db.Uuid
  warehouseId   String?               @map("warehouse_id") @db.Uuid
  actorId       String?               @map("actor_id") @db.Uuid
  type          InventoryMovementType
  quantityDelta Int                   @map("quantity_delta")
  reference     String?               @db.VarChar(160)
  note          String?               @db.VarChar(1000)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  store     Store?         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([storeId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([actorId, createdAt])
  @@map("stock_movements")
}

model Order {
  id                      String      @id @default(uuid()) @db.Uuid
  orderNumber             String      @unique @map("order_number") @db.VarChar(40)
  buyerId                 String      @map("buyer_id") @db.Uuid
  storeId                 String?     @map("store_id") @db.Uuid
  status                  OrderStatus @default(PENDING)
  currency                String      @default("INR") @db.Char(3)
  subtotal                Decimal     @map("subtotal") @db.Decimal(12, 2)
  discountTotal           Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal                Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal           Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  grandTotal              Decimal     @map("grand_total") @db.Decimal(12, 2)
  shippingAddressId       String?     @map("shipping_address_id") @db.Uuid
  billingAddressId        String?     @map("billing_address_id") @db.Uuid
  shippingAddressSnapshot Json?       @map("shipping_address_snapshot")
  billingAddressSnapshot  Json?       @map("billing_address_snapshot")
  customerNote            String?     @map("customer_note") @db.VarChar(2000)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  buyer           User                 @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  store           Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  shippingAddress Address?             @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?             @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  posTransaction  POSTransaction?      @relation("OrderFromPOS")

  @@index([buyerId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  customizationId   String?  @map("customization_id") @db.Uuid
  productName       String   @map("product_name") @db.VarChar(200)
  sku               String   @db.VarChar(100)
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(12, 2)
  customizationData Json?    @map("customization_data")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customization Customization? @relation(fields: [customizationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  note      String?     @db.VarChar(1000)
  changedBy String?     @map("changed_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  provider          String?       @db.VarChar(80)
  providerReference String?       @unique @map("provider_reference") @db.VarChar(200)
  platformFee       Decimal       @default(0) @map("platform_fee") @db.Decimal(12, 2)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String?  @db.VarChar(80)
  recipient   String   @db.VarChar(160)
  phone       String   @db.VarChar(32)
  line1       String   @db.VarChar(240)
  line2       String?  @db.VarChar(240)
  city        String   @db.VarChar(120)
  state       String   @db.VarChar(120)
  postalCode  String   @map("postal_code") @db.VarChar(24)
  countryCode String   @default("IN") @map("country_code") @db.Char(2)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId, isDefault])
  @@map("addresses")
}

model Customization {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  variantId         String              @map("variant_id") @db.Uuid
  templateId        String?             @map("template_id") @db.Uuid
  status            CustomizationStatus @default(DRAFT)
  currentPrice      Decimal             @map("current_price") @db.Decimal(12, 2)
  currency          String              @default("INR") @db.Char(3)
  previewUrl        String?             @map("preview_url") @db.VarChar(2048)
  productionFileUrl String?             @map("production_file_url") @db.VarChar(2048)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  template   JerseyTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  views      CustomizationView[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  posItems   POSTransactionItem[]

  @@index([userId, status, updatedAt])
  @@index([productId, status])
  @@index([templateId])
  @@map("customizations")
}

model CustomizationView {
  id              String               @id @default(uuid()) @db.Uuid
  customizationId String               @map("customization_id") @db.Uuid
  surface         CustomizationSurface
  canvasWidth     Int                  @default(1000) @map("canvas_width")
  canvasHeight    Int                  @default(1000) @map("canvas_height")
  backgroundUrl   String?              @map("background_url") @db.VarChar(2048)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  customization Customization          @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  elements      CustomizationElement[]

  @@unique([customizationId, surface])
  @@map("customization_views")
}

model CustomizationElement {
  id          String                   @id @default(uuid()) @db.Uuid
  viewId      String                   @map("view_id") @db.Uuid
  type        CustomizationElementType
  text        String?                  @db.VarChar(500)
  x           Float                    @default(0) @db.DoublePrecision
  y           Float                    @default(0) @db.DoublePrecision
  width       Float                    @default(0) @db.DoublePrecision
  height      Float                    @default(0) @db.DoublePrecision
  rotation    Float                    @default(0) @db.DoublePrecision
  scaleX      Float                    @default(1) @map("scale_x") @db.DoublePrecision
  scaleY      Float                    @default(1) @map("scale_y") @db.DoublePrecision
  zIndex      Int                      @default(0) @map("z_index")
  fillColor   String?                  @map("fill_color") @db.VarChar(32)
  strokeColor String?                  @map("stroke_color") @db.VarChar(32)
  strokeWidth Float?                   @map("stroke_width") @db.DoublePrecision
  fontFamily  String?                  @map("font_family") @db.VarChar(120)
  fontSize    Float?                   @map("font_size") @db.DoublePrecision
  textAlign   String?                  @map("text_align") @db.VarChar(16)
  curvature   Float?                   @db.DoublePrecision
  assetUrl    String?                  @map("asset_url") @db.VarChar(2048)
  svgData     String?                  @map("svg_data") @db.Text
  properties  Json                     @default("{}")
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  view CustomizationView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([viewId, zIndex])
  @@map("customization_elements")
}

model JerseyTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(160)
  slug        String         @unique @db.VarChar(180)
  productType ProductType    @map("product_type")
  version     Int            @default(1)
  status      TemplateStatus @default(DRAFT)
  description String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  views          JerseyTemplateView[]
  customizations Customization[]
  pricingRules   CustomizerPricingRule[]

  @@index([productType, status])
  @@map("jersey_templates")
}

model JerseyTemplateView {
  id              String               @id @default(uuid()) @db.Uuid
  templateId      String               @map("template_id") @db.Uuid
  surface         CustomizationSurface
  previewUrl      String?              @map("preview_url") @db.VarChar(2048)
  printableBounds Json?                @map("printable_bounds")
  canvasWidth     Int                  @default(1000) @map("canvas_width")
  canvasHeight    Int                  @default(1000) @map("canvas_height")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  template JerseyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, surface])
  @@map("jersey_template_views")
}

model CustomizerPricingRule {
  id                   String      @id @default(uuid()) @db.Uuid
  templateId           String?     @map("template_id") @db.Uuid
  productType          ProductType @map("product_type")
  currency             String      @default("INR") @db.Char(3)
  baseCustomizationFee Decimal     @default(0) @map("base_customization_fee") @db.Decimal(12, 2)
  frontPrintFee        Decimal     @default(0) @map("front_print_fee") @db.Decimal(12, 2)
  backPrintFee         Decimal     @default(0) @map("back_print_fee") @db.Decimal(12, 2)
  sleeveLogoFee        Decimal     @default(0) @map("sleeve_logo_fee") @db.Decimal(12, 2)
  additionalLogoFee    Decimal     @default(0) @map("additional_logo_fee") @db.Decimal(12, 2)
  maxLogos             Int         @default(1) @map("max_logos")
  allowedFileTypes     String[]    @default(["image/png", "image/jpeg", "image/svg+xml"]) @map("allowed_file_types")
  maxUploadBytes       Int         @default(4000000) @map("max_upload_bytes")
  printableBounds      Json?       @map("printable_bounds")
  allowedFonts         String[]    @default([]) @map("allowed_fonts")
  allowedTextColors    String[]    @default([]) @map("allowed_text_colors")
  active               Boolean     @default(true)
  effectiveFrom        DateTime?   @map("effective_from") @db.Timestamptz(3)
  effectiveUntil       DateTime?   @map("effective_until") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  template JerseyTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([productType, active, effectiveFrom, effectiveUntil])
  @@index([templateId, active])
  @@map("customizer_pricing_rules")
}

model POSTransaction {
  id                  String               @id @default(uuid()) @db.Uuid
  storeId             String               @map("store_id") @db.Uuid
  cashierId           String               @map("cashier_id") @db.Uuid
  orderId             String?              @unique @map("order_id") @db.Uuid
  clientTransactionId String?              @unique @map("client_transaction_id") @db.VarChar(160)
  status              POSTransactionStatus @default(OPEN)
  currency            String               @default("INR") @db.Char(3)
  subtotal            Decimal              @db.Decimal(12, 2)
  discountTotal       Decimal              @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal            Decimal              @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal          Decimal              @map("grand_total") @db.Decimal(12, 2)
  cashTendered        Decimal?             @map("cash_tendered") @db.Decimal(12, 2)
  changeDue           Decimal?             @map("change_due") @db.Decimal(12, 2)
  paymentReference    String?              @map("payment_reference") @db.VarChar(200)
  offlineCreatedAt    DateTime?            @map("offline_created_at") @db.Timestamptz(3)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cashier  User                 @relation("POSCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  order    Order?               @relation("OrderFromPOS", fields: [orderId], references: [id], onDelete: SetNull)
  items    POSTransactionItem[]
  payments POSPayment[]

  @@index([storeId, status, createdAt])
  @@index([cashierId, createdAt])
  @@map("pos_transactions")
}

model POSTransactionItem {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @map("transaction_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  customizationId String?  @map("customization_id") @db.Uuid
  productName     String   @map("product_name") @db.VarChar(200)
  sku             String   @db.VarChar(100)
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction   POSTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customization Customization? @relation(fields: [customizationId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([variantId, createdAt])
  @@map("pos_transaction_items")
}

model POSPayment {
  id                String        @id @default(uuid()) @db.Uuid
  transactionId     String        @map("transaction_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  providerReference String?       @map("provider_reference") @db.VarChar(200)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction POSTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, status])
  @@map("pos_payments")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@index([productId])
  @@map("wishlist_items")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id              String   @id @default(uuid()) @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  customizationId String?  @map("customization_id") @db.Uuid
  itemKey         String   @map("item_key") @db.VarChar(240)
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customization Customization? @relation(fields: [customizationId], references: [id], onDelete: SetNull)

  @@unique([cartId, itemKey])
  @@index([variantId])
  @@map("cart_items")
}
